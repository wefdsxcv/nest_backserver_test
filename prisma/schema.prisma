generator client {
  provider = "prisma-client-js" // ★ここを "prisma-client-js" にしておきます
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL") 👈 ★もし残っていたら、この行は完全に削除（またはコメントアウト）します
}

model Message {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(255)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

