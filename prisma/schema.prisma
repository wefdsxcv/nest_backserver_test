generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // ★ここに復活！
}

model Message {
  id        Int      @id @default(autoincrement())
  text      String   @db.VarChar(255)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
  // ★追記：user_id と created_at の組み合わせに対する「複合インデックス」を定義
  // user_id で絞り込んだ後、あらかじめ created_at の降順(desc)で並んでいる目次を作ります
  @@index([userId, createdAt(sort: Desc)])
}

